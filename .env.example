# ============================================================
# Variables de entorno — San Francisco de Asís
# Copia este archivo como `.env` en la raíz del proyecto y
# ajusta los valores según tu entorno.
# ============================================================

# ---------- API Gateway (:5000) ----------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=5000

# URL internas de los microservicios
PEDIDOS_URL=http://127.0.0.1:5001
SEPARADO_URL=http://127.0.0.1:5002

# Credenciales del panel de tienda (autenticación básica)
PANEL_USER=admin
PANEL_PASSWORD=san-francisco-2024
PANEL_TOKEN=sfa-token-demo-2024

# ---------- Microservicio 1 — Pedidos (:5001) ----------
PEDIDOS_HOST=0.0.0.0
PEDIDOS_PORT=5001
# PostgreSQL en Alwaysdata (cada microservicio tiene la suya):
#   postgresql://usuario:clave@host:puerto/nombre_bd_pedidos
# Si no se define, se usa SQLite local (solo desarrollo).
DATABASE_URL_PEDIDOS=

# ---------- Microservicio 2 — Separado de tortas (:5002) ----------
SEPARADO_HOST=0.0.0.0
SEPARADO_PORT=5002
# postgresql://usuario:clave@host:puerto/nombre_bd_reservas
DATABASE_URL_SEPARADO=

# ---------- Cloudinary (imágenes de productos) ----------
# Obtén estos valores en tu panel de Cloudinary (Dashboard).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional: URL completa de Cloudinary (cloudinary://key:secret@cloud_name)
CLOUDINARY_URL=

# ---------- Generales ----------
# Clave secreta (cámbiala en producción)
SECRET_KEY=cambio-en-produccion

# Correo del conector de notificaciones
NOTIFICACION_EMAIL=tienda@sanfranciscodeasis.com